# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=

# Long random string used to encrypt private data. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe: if you lose it, existing encrypted entries cannot be read.
SECRET_KEY=

PORT=3000

# Which websites may call this API (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Optional: folder with the HTML pages, and the page to show at "/"
# FRONTEND_DIR=G:/college/stitch/stitch
# HOME_PAGE=rkive_personal_dashboard/code.html

# Set to true for hackathon demos: creates 3 demo users and a "pick a user" login.
DEMO_MODE=false
